# Variables de la API. En local se copian a .env (raíz del repo), que nunca se versiona.
# En producción (Cloud Run) las carga el pipeline desde Secret Manager.

# Vacío (o development) en tu PC; production en Cloud Run.
NODE_ENV=

# Local: contraseña del Postgres del docker-compose (se usa si DATABASE_URL está vacía)
POSTGRES_PASSWORD=
# Producción: connection string de Neon (siempre con SSL)
DATABASE_URL=

# Puerto: Cloud Run lo define solo. En local, por defecto 3000.
PORT=
# URL pública de la API (obligatoria en producción). Local: http://localhost:3000
API_URL=
