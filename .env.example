# Variables de la API. En local se copian a .env (raíz del repo), que nunca se versiona.
# En producción (Cloud Run) las carga el pipeline desde Secret Manager.

# Vacío (o development) en tu PC; production en Cloud Run.
NODE_ENV=

# Local: contraseña del Postgres del docker-compose (se usa si DATABASE_URL está vacía)
POSTGRES_PASSWORD=
# Producción: connection string de Neon (siempre con SSL)
DATABASE_URL=

# Puerto: Cloud Run lo define solo. En local, por defecto 3000.
PORT=
# URL pública de la API (obligatoria en producción). Local: http://localhost:3000
API_URL=

# IA (foto del plato y coach). Ver apps/api/src/ia/config.js.
# Proveedor: gemini o claude (solo desarrollo, con clave); vertex-gemini o vertex-claude (producción).
# Vacío: la IA queda apagada y esas rutas responden 503.
IA_PROVEEDOR=
# Modelos (vacíos: gemini-3.8-flash con Gemini, claude-haiku-5-5 con Claude)
IA_MODELO_FOTO=
IA_MODELO_COACH=
# Claves, solo para desarrollo local. En producción no hay claves: Vertex usa la cuenta de servicio de Cloud Run.
GEMINI_API_KEY=
# Opcional: sin ella, el proveedor claude queda apagado
ANTHROPIC_API_KEY=
# Vertex AI: proyecto de Google Cloud y región (vacía: global)
IA_VERTEX_PROYECTO=
IA_VERTEX_REGION=
# Usos por día de cada dispositivo (vacíos: 10 fotos y 30 mensajes)
IA_LIMITE_FOTOS_DIA=
IA_LIMITE_MENSAJES_DIA=
